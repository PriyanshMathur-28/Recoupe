# Copy this file to .env and replace every placeholder with your own values.
# Never commit .env or paste real secrets into source files.

# Google OAuth files. Run: python oauth_flow.py
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Maximum time for each Gmail API HTTP request before the case is escalated.
GMAIL_HTTP_TIMEOUT_SECONDS=30

# Configure at least one LLM provider for live customer messages.
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=replace_with_gemini_api_key

# Razorpay Test Mode credentials.
RAZORPAY_KEY_ID=replace_with_razorpay_test_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# Dashboard authentication and session signing.
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=replace_with_strong_dashboard_password
FLASK_SECRET_KEY=replace_with_long_random_secret

# Optional.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Vapi – Voice Recovery (Laptop Browser → Vapi Web Call → AI Agent → Backend)
# ---------------------------------------------------------------------------
# Flow: operator opens the Voice Calling panel in Chrome/Edge, presses
# "Start Call", the @vapi-ai/web SDK in the browser initiates a WebRTC session
# with Vapi cloud, the AI agent speaks to the client, the transcript comes back
# to your Flask backend via POST /api/voice/complete-call (browser-reported)
# or POST /webhooks/vapi (Vapi server-push), whichever arrives first.
#
# WHERE TO GET THESE VALUES
# ─────────────────────────
# 1. Sign up / log in at https://dashboard.vapi.ai
# 2. Go to Account → API Keys to find your Public Key and Private Key.
# 3. Go to Assistants → Create to build an assistant and copy its ID.
# 4. Go to Webhooks to configure the server URL and shared secret.
# 5. Go to Phone Numbers to buy/import a number and copy its ID.
# 6. ElevenLabs voice IDs come from your ElevenLabs account.

# REQUIRED for web calls — the only credential the browser SDK needs.
# This is a public key by design; it is safe to ship to the browser.
# Without this, the system runs in Demo Mode (simulated calls, no Vapi).
VAPI_PUBLIC_KEY=replace_with_vapi_public_key

# OPTIONAL — used only for outbound phone calls (not the browser web-call flow).
# The private key must NEVER appear in a browser response; it stays server-side.
VAPI_PRIVATE_KEY=replace_with_vapi_private_key

# OPTIONAL — ID of a pre-configured Vapi assistant to use for every call.
# If absent, the backend auto-generates a transient assistant inline using the
# system prompt in modules/vapi_client.py — calls work without this.
VAPI_ASSISTANT_ID=replace_with_vapi_assistant_id

# OPTIONAL — shared secret Vapi sends in the X-Vapi-Secret header on every
# server-push webhook (POST /webhooks/vapi). Validates that payloads come from
# Vapi, not an attacker. Webhooks are accepted without validation if this is unset.
VAPI_WEBHOOK_SECRET=replace_with_vapi_webhook_secret

# OPTIONAL — ElevenLabs voice ID for a premium TTS voice on the AI agent.
# Vapi uses its built-in TTS if this is unset.
VAPI_VOICE_ID=replace_with_elevenlabs_voice_id

# OPTIONAL — phone number ID from the Vapi dashboard, required only for
# outbound telephony calls (i.e. placing a real phone call to the client's
# mobile). The browser web-call flow does NOT need this.
VAPI_PHONE_NUMBER_ID=replace_with_vapi_phone_number_id

# Set to "true" to force Demo Mode regardless of whether VAPI_PUBLIC_KEY is set.
# Demo Mode simulates calls locally — no Vapi account needed, useful for demos.
VOICE_DEMO_MODE=false
