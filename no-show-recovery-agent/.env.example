# Copy this file to .env and replace every placeholder with your own values.
# Never commit .env or paste real secrets into source files.

# Google OAuth files. Run: python oauth_flow.py
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Maximum time for each Gmail API HTTP request before the case is escalated.
GMAIL_HTTP_TIMEOUT_SECONDS=30

# Configure at least one LLM provider for live customer messages.
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=replace_with_gemini_api_key

# Razorpay Test Mode credentials.
RAZORPAY_KEY_ID=replace_with_razorpay_test_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# Dashboard authentication and session signing.
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=replace_with_strong_dashboard_password
FLASK_SECRET_KEY=replace_with_long_random_secret

# Optional.
LOG_LEVEL=INFO
